<ci:ComponentBase x:TypeArguments="models:PickComponentSettings"
                  x:Class="ClassIsland.RandomStudentPicker.Components.RandomPickerComponentSettingsControl"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:local="clr-namespace:ClassIsland.RandomStudentPicker.Components"
                  xmlns:models="clr-namespace:ClassIsland.RandomStudentPicker.Models"
                  xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Classes="component-settings-container animated-intro" Margin="0"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:RandomPickerComponentSettingsControl}}">

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE8AC;}"
                                        Header="按钮文字"
                                        Description="显示在抽取按钮上的文字。">
                <controls1:SettingsExpander.Footer>
                    <TextBox MinWidth="160"
                             Text="{Binding Settings.ButtonText, UpdateSourceTrigger=PropertyChanged}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE510;}"
                                        Header="字体大小"
                                        Description="组件中文字的大小。">
                <controls1:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Slider Width="170" Minimum="10" Maximum="40"
                                TickFrequency="1" TickPlacement="None" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.FontSize, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Settings.FontSize}" VerticalAlignment="Center" Width="28" />
                    </StackPanel>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE7C1;}"
                                        Header="显示图标"
                                        Description="是否在按钮上显示一个骰子图标。">
                <controls1:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowIcon, Mode=TwoWay}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE9D9;}"
                                        Header="在组件上显示抽取结果"
                                        Description="关闭后组件只保留抽取按钮，结果改为只通过 ClassIsland 提醒显示。">
                <controls1:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowResultInComponent, Mode=TwoWay}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xEC54;}"
                                        Header="自定义字体颜色"
                                        Description="选择组件中文字的颜色。">
                <controls1:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Classes="items-valign-center" Spacing="4">
                        <ColorPicker Color="{Binding Settings.FontColor, Mode=TwoWay}"
                                     IsVisible="{Binding Settings.UseCustomFontColor}" />
                        <ToggleSwitch IsChecked="{Binding Settings.UseCustomFontColor, Mode=TwoWay}" />
                    </StackPanel>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
