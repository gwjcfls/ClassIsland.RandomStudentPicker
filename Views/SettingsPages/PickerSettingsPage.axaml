<ci:SettingsPageBase x:Class="ClassIsland.RandomStudentPicker.Views.SettingsPages.PickerSettingsPage"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:ci="http://classisland.tech/schemas/xaml/core"
                    xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                    xmlns:local="clr-namespace:ClassIsland.RandomStudentPicker.Views.SettingsPages"
                    mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">

    <ScrollViewer>
        <StackPanel MaxWidth="820" Spacing="6">

            <controls1:InfoBar Severity="Informational"
                               IsOpen="True"
                               IsClosable="False"
                               Title="使用步骤"
                               Message="1. 在下方维护备选同学名单，一行一个姓名；2. 打开【应用设置】→【组件】，把「随机抽取同学」拖到主界面；3. 鼠标移到主界面上的按钮上，按钮会临时变为可点击，点击即可抽取。ClassIsland 主界面默认点击穿透，插件会按需临时放开，鼠标移开后自动恢复。" />

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xECAA;}"
                                        Header="备选同学名单"
                                        Description="一行一个姓名。可以直接粘贴 Excel 或文本名单，空行会自动忽略。">
                <controls1:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Name="RosterSummaryTextBlock" VerticalAlignment="Center" />
                        <Button Content="试抽一次" Click="PickOnce_OnClick" />
                    </StackPanel>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <TextBox Name="RosterTextBox"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     MinHeight="220"
                     Watermark="张三&#x0a;李四&#x0a;王五"
                     TextChanged="RosterTextBox_OnTextChanged"
                     Margin="0 0 0 6" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 0 0 6">
                <Button Content="保存名单" Click="Save_OnClick" />
                <Button Content="追加示例名单" Click="AppendSample_OnClick" />
                <Button Content="清空名单" Foreground="IndianRed" Click="Clear_OnClick" />
            </StackPanel>

            <TextBlock Name="StatusTextBlock"
                       Margin="2 0 0 10"
                       IsVisible="False"
                       TextWrapping="Wrap" />

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE1F5;}"
                                        Header="避免连续抽到同一人"
                                        Description="开启后，下一次抽取会自动排除上一次抽到的同学。">
                <controls1:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AvoidRepeat, Mode=TwoWay}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE9D2;}"
                                        Header="语音朗读抽取结果"
                                        Description="抽取后通过 ClassIsland 提醒朗读姓名（需要在提醒设置中开启语音）。">
                <controls1:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.EnableSpeech, Mode=TwoWay}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE8AC;}"
                                        Header="提醒文本前缀"
                                        Description="提醒中显示的文本 = 前缀 + 姓名。留空则只显示姓名。">
                <controls1:SettingsExpander.Footer>
                    <TextBox MinWidth="180"
                             Text="{Binding Settings.NotifyPrefix, UpdateSourceTrigger=PropertyChanged}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xF361;}"
                                        Header="提醒显示时长"
                                        Description="抽取结果提醒在屏幕上停留的秒数。">
                <controls1:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Slider Name="NotifyDurationSlider" Width="170" Minimum="2" Maximum="60"
                                TickFrequency="1" TickPlacement="None" IsSnapToTickEnabled="True"
                                ValueChanged="NotifyDurationSlider_OnValueChanged" />
                        <TextBlock Name="NotifyDurationTextBlock"
                                   MinWidth="52"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE5C3;}"
                                        Header="抽取时保持主界面不淡化"
                                        Description="ClassIsland 默认会在鼠标移入主界面时把整行淡化到几乎透明，而点击抽取按钮后鼠标必定还停在主界面上，抽取结果提醒会因此看不清。开启后，鼠标停在抽取按钮上、以及抽取后提醒显示的这段时间里，插件会临时让主界面保持正常不透明度；移开鼠标即恢复原本的淡化行为。本项不会修改 ClassIsland 自身的设置。">
                <controls1:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.KeepIslandVisible, Mode=TwoWay}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE7C1;}"
                                        Header="主界面点击方式"
                                        Description="ClassIsland 主界面默认点击穿透，组件里的按钮收不到鼠标点击。插件用低级鼠标钩子捕捉落在组件上的点击，并且会「吃掉」这一次点击（不会同时点到主界面后面的窗口）。选择【关闭】时组件只用于显示结果，抽取请用上面的「试抽一次」。">
                <controls1:SettingsExpander.Footer>
                    <ComboBox Name="ClickModeComboBox" MinWidth="180" SelectionChanged="ClickMode_OnSelectionChanged">
                        <ComboBoxItem Content="全局鼠标钩子（推荐）" Tag="1" />
                        <ComboBoxItem Content="关闭（仅显示）" Tag="0" />
                    </ComboBox>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE897;}"
                                        Header="名单为空时的提示"
                                        Description="备选同学名单为空时，组件上显示的提示文字。">
                <controls1:SettingsExpander.Footer>
                    <TextBox MinWidth="220"
                             Text="{Binding Settings.EmptyRosterHint, UpdateSourceTrigger=PropertyChanged}" />
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
